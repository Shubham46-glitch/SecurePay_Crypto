PORT=5000
NODE_ENV=development

# No database needed — all data is stored in process memory.
# Balances reset on every server restart (expected for this demo).

JWT_SECRET=your_secure_jwt_secret_key_here
HMAC_SECRET=your_secure_server_side_hmac_secret_key_here
NONCE_EXPIRY_SECONDS=300

# Set this to your GitHub Pages URL in production (Vercel environment variables)
# e.g. https://vinay-ops.github.io
CLIENT_URL=http://localhost:3000
